+    /// #1404 root-cause probe (temporary): current WAL command-channel
+    /// depth (queued-but-unconsumed `WalCmd`s). See
+    /// [`arcgraph_storage::wal::WalHandle::queue_len`].
+    #[must_use]
+    pub fn wal_queue_len(&self) -> usize {
+        self.wal_handle.queue_len()
+    }
+
+    /// #1404 root-cause probe (temporary): spawn a background thread that
+    /// logs the WAL channel depth + byte watermarks every `secs`. If the
+    /// STEP-0 hypothesis holds, `wal_queue_len` grows unbounded during a
+    /// sustained ingest; under Strict/T1 self-throttling it stays small.
+    pub fn spawn_1404_probe(&self, secs: u64) {
+        let wal = self.wal_handle.clone();
+        // The stdio binary ships without a tracing sink (see the bin's tracing
+        // init comment), so `tracing::info!` is dropped. Write the probe samples
+        // DIRECTLY to a file (path from ARCGRAPH_1404_PROBE_FILE, default /tmp).
+        let path = std::env::var("ARCGRAPH_1404_PROBE_FILE")
+            .unwrap_or_else(|_| "/tmp/probe_1404.log".to_owned());
+        std::thread::Builder::new()
+            .name("probe-1404".to_owned())
+            .spawn(move || {
+                use std::io::Write;
+                let mut f = std::fs::OpenOptions::new()
+                    .create(true)
+                    .append(true)
+                    .open(&path)
+                    .ok();
+                let start = std::time::Instant::now();
+                loop {
+                    std::thread::sleep(std::time::Duration::from_secs(secs));
+                    let qlen = wal.queue_len();
+                    let appended = wal.wal_bytes_appended();
+                    let durable = wal.last_durable_lsn().raw();
+                    let t = start.elapsed().as_secs();
+                    if let Some(f) = f.as_mut() {
+                        let _ = writeln!(
+                            f,
+                            "PROBE-1404 t={t}s wal_queue_len={qlen} \
+                             wal_bytes_appended={appended} durable_lsn={durable}"
+                        );
+                        let _ = f.flush();
+                    }
+                }
+            })
+            .ok();
+    }
