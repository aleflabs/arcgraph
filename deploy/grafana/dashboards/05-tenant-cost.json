      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "CPU ms consumed per tenant (rate over 5m). Top-N tenants by CPU burn — billing + throttling signal.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": false},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "legend": {"calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "topk(10, sum by (tenant_id) (rate(arcgraph_tenant_cost_cpu_ms_total{tenant_id=~\"$tenant\"}[5m])))",
          "legendFormat": "{{tenant_id}}",
          "range": true,
          "refId": "A"
