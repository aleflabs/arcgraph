{
  "_comment": "W25-OPS-PROD / ADR-093-amendment-01 §D-1 (Grafana pack) consuming §D-6 (cost telemetry) — Per-tenant cost telemetry dashboard. Consumes arcgraph_tenant_cost_* metrics (forward-bound to the M6-08+ metrics HTTP exporter that reads from arcgraph_core::cost_telemetry::PerTenantCostRegistry). Surfaces the same four dimensions as the admin HTTP /cost/{tenant_id} JSON: cpu_ms, mem_mb_peak, bytes_read, bytes_written.",
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
